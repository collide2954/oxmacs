#!/bin/sh
set -eu

for name in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
    unset "$name"
done

tree="$(git rev-parse --show-toplevel)/target/pre-push"
checked=""

while read -r _local_ref sha _remote_ref _remote_sha; do
    case "$sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    case " $checked " in
        *" $sha "*) continue ;;
    esac
    checked="$checked $sha"
    git worktree prune
    if [ -f "$tree/.git" ]; then
        git -C "$tree" checkout --quiet --force --detach "$sha"
    else
        rm -rf "$tree"
        git worktree add --quiet --detach "$tree" "$sha"
    fi
    echo "pre-push: checking $(git log -1 --format='%h %s' "$sha")"
    (
        cd "$tree"
        cargo fmt --all --check
        cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
        cargo test --workspace --all-features --locked --quiet
        cargo test --workspace --locked --quiet
    ) </dev/null
done
